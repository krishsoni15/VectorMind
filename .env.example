# Supabase Configuration
# Obtain your project URL and keys from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Encryption Key for User API Credentials (32-byte hex, generate via: openssl rand -hex 32)
CREDENTIAL_ENCRYPTION_KEY=your_credential_encryption_key

# AI Provider API Keys
# Get your Cohere key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Get your Gemini key at https://ai.google.dev/
GEMINI_API_KEY=

# Get your Groq key at https://console.groq.com/keys
GROQ_API_KEY=

# Get your OpenAI key at https://platform.openai.com/api-keys (Optional)
OPENAI_API_KEY=

# Upstash Redis - For Rate Limiting (Optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash Vector - For Semantic Caching (Optional)
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=